# Local sandbox only. Copy to .env and generate a fresh password (README command).
COMPOSE_PROJECT_NAME=klados-dev
POSTGRES_PASSWORD=replace-with-generated-local-password
KLADOS_PORT=8080
# Mock mode never calls a provider. Use live only after explicit local budget/key setup.
KLADOS_AI_MODE=mock
OPENROUTER_API_KEY_AGENTS=
OPENROUTER_API_KEY_OBSERVER=
